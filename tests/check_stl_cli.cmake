if(NOT DEFINED executable OR NOT DEFINED fixture OR NOT DEFINED test_directory)
    message(FATAL_ERROR "Missing STL CLI test arguments")
endif()
file(REMOVE_RECURSE "${test_directory}")
file(MAKE_DIRECTORY "${test_directory}")
execute_process(COMMAND "${executable}" --check-stl "${fixture}"
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT status EQUAL 0 OR NOT output MATCHES "STL conversion: supported" OR NOT error STREQUAL "")
    message(FATAL_ERROR "STL preflight failed: ${status}\n${output}\n${error}")
endif()
if(EXISTS "${test_directory}/bundle")
    message(FATAL_ERROR "STL preflight published output")
endif()
execute_process(COMMAND "${executable}" --convert-stl "${fixture}" --output "${test_directory}/bundle"
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT status EQUAL 0 OR NOT EXISTS "${test_directory}/bundle/model.pbrt"
   OR NOT EXISTS "${test_directory}/bundle/conversion.json" OR NOT error STREQUAL "")
    message(FATAL_ERROR "STL conversion failed: ${status}\n${output}\n${error}")
endif()
file(SHA256 "${test_directory}/bundle/conversion.json" original)
execute_process(COMMAND "${executable}" --convert-stl "${fixture}" --output "${test_directory}/bundle"
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error)
file(SHA256 "${test_directory}/bundle/conversion.json" after)
if(NOT status EQUAL 1 OR NOT original STREQUAL after)
    message(FATAL_ERROR "STL conversion replaced an existing bundle: ${status}\n${output}\n${error}")
endif()
file(WRITE "${test_directory}/malformed.stl" "solid incomplete\nfacet normal 0 0 1\n")
execute_process(COMMAND "${executable}" --convert-stl "${test_directory}/malformed.stl"
    --output "${test_directory}/rejected" RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT status EQUAL 1 OR EXISTS "${test_directory}/rejected")
    message(FATAL_ERROR "Malformed STL did not fail before publication: ${status}\n${output}\n${error}")
endif()
execute_process(COMMAND "${executable}" --check-stl "${fixture}" --stl-colors magics
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT status EQUAL 2)
    message(FATAL_ERROR "ASCII STL accepted a binary vendor color mode: ${status}\n${output}\n${error}")
endif()
execute_process(COMMAND "${executable}" --convert-stl "${fixture}" --stl-colors auto
    --output "${test_directory}/reordered" RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT status EQUAL 0 OR NOT EXISTS "${test_directory}/reordered/model.pbrt")
    message(FATAL_ERROR "Reordered STL options failed: ${status}\n${output}\n${error}")
endif()
file(GLOB stages "${test_directory}/.rypath-*")
if(stages)
    message(FATAL_ERROR "STL conversion left staging directories: ${stages}")
endif()
file(REMOVE_RECURSE "${test_directory}")
