set(metal_skip_marker "RYPATH_CTEST_SKIP_NO_METAL_DEVICE")
set(render_skip_marker "RYPATH_CTEST_SKIP_RENDER_UNAVAILABLE")

function(get_cli_skip_regex result marker metal_enabled allow_no_device allow_no_ray_tracing)
    set(regex "")
    if(metal_enabled AND (allow_no_device OR allow_no_ray_tracing))
        # CTest can match a skip expression even when the validator exits with an error.
        # Only the validator's first, complete output line can signal a skip.
        set(regex "^${marker}\n")
    endif()
    set("${result}" "${regex}" PARENT_SCOPE)
endfunction()

function(get_render_availability result stdout stderr warning_pattern)
    set(status "")
    set(reason "")
    string(REGEX MATCHALL "(^|\n)Render status:" status_lines "${stdout}")
    list(LENGTH status_lines count)
    if(count EQUAL 1 AND NOT stdout MATCHES "Committed samples|Total samples:|Wrote PNG")
        if(NOT metal_enabled AND stdout MATCHES "(^|\n)Render status: not_built\n")
            set(status "not_built")
            set(reason "Metal backend was not built")
        elseif(metal_enabled)
            if(allow_no_device AND stdout MATCHES "(^|\n)Render status: no_device\n")
                set(status "no_device")
                set(reason "No system-default Metal device")
            elseif(allow_no_ray_tracing AND stdout MATCHES "(^|\n)Render status: no_ray_tracing\n")
                set(status "no_ray_tracing")
                set(reason "System-default Metal device does not support compute ray tracing")
            endif()
        endif()
    endif()
    if(NOT stderr MATCHES "^${warning_pattern}rypath: ${reason}\n$")
        set(status "")
    endif()
    set("${result}" "${status}" PARENT_SCOPE)
endfunction()
