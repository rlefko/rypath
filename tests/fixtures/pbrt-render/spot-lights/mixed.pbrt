# SPDX-License-Identifier: GPL-3.0-only
# Owned spot-light wrapper; external geometry terms are recorded separately.
Camera "perspective" "float fov" [28]
Film "rgb" "integer xresolution" [8] "integer yresolution" [8]
 "string sensor" "cie1931" "float iso" [100] "bool savefp16" [false]
PixelFilter "box"
Sampler "independent" "integer pixelsamples" [4096] "integer seed" [0]
Integrator "path" "integer maxdepth" [3]
WorldBegin
LightSource "spot" "point3 from" [0 0 1] "point3 to" [0 0 3] "spectrum I" [360 4 830 4]
LightSource "point" "point3 from" [-1 -.7 0] "spectrum I" [360 2 830 2]
LightSource "infinite" "spectrum L" [360 .1 830 .1]
Material "diffuse" "spectrum reflectance" [360 .6 830 .6]
Shape "trianglemesh" "point3 P" [-4 -4 3 4 -4 3 4 4 3 -4 4 3] "integer indices" [0 2 1 0 3 2]
AttributeBegin
Material "diffuse" "spectrum reflectance" [360 0 830 0]
AreaLightSource "diffuse" "spectrum L" [360 2 830 2] "bool twosided" [true]
Shape "trianglemesh" "point3 P" [-1 1.5 1 1 1.5 1 1 1.5 2 -1 1.5 2] "integer indices" [0 1 2 0 2 3]
AttributeEnd
