# SPDX-License-Identifier: GPL-3.0-only
# Owned spot-light wrapper; external geometry terms are recorded separately.
Camera "perspective" "float fov" [28]
Film "rgb" "integer xresolution" [8] "integer yresolution" [8]
 "string sensor" "cie1931" "float iso" [100] "bool savefp16" [false]
PixelFilter "box"
Sampler "independent" "integer pixelsamples" [4096] "integer seed" [0]
Integrator "path" "integer maxdepth" [3]
WorldBegin
LightSource "spot" "point3 from" [0 0 1] "point3 to" [0 0 3] "float coneangle" [25] "float conedeltaangle" [15] "spectrum I" [360 4 830 4]
Material "diffuse" "spectrum reflectance" [360 .6 830 .6]
Translate 0.08 -0.04 3
Rotate 13 0 0 1
Rotate 180 0 1 0
Scale 6 0.07 1
Shape "plymesh" "string filename" "assets/sportscar-quad.ply"
