Camera "perspective" "float fov" [53.1301023542]
Film "rgb" "integer xresolution" [8] "integer yresolution" [8]
    "string sensor" "cie1931" "float iso" [100] "bool savefp16" [false]
PixelFilter "triangle" "float xradius" [0.00390625] "float yradius" [0.00390625]
Sampler "independent" "integer pixelsamples" [4096] "integer seed" [0]
Integrator "path" "integer maxdepth" [1]
WorldBegin
LightSource "infinite"
# LOD 2.625 selects the 8x8 mip. Column 4 stays near s=0.025
# inside the bright red texel, close enough to the repeat seam for bilinear mixing.
Texture "surface" "spectrum" "imagemap" "string filename" "image-assets/z03n2c08.png"
    "string wrap" "repeat" "string filter" "point"
    "float uscale" [3.08442165082] "float udelta" [-3.44497435717] "float vdelta" [0.05]
Material "diffuse" "texture reflectance" "surface"
Shape "trianglemesh" "point3 P" [-1 -1 2 1 -1 2 -1 1 2 1 1 2]
    "integer indices" [0 1 2 2 1 3] "point2 uv" [0 0.4 2 0.4 0 0.6 2 0.6]
