# SPDX-License-Identifier: GPL-3.0-only
# Original rypath EWA image texture at focus and defocused depth.
LookAt 0 0 0 0 0 1 0 1 0
Camera "perspective" "float fov" [45] "float lensradius" [.25] "float focaldistance" [3]
Film "rgb" "integer xresolution" [8] "integer yresolution" [8]
 "string sensor" "cie1931" "float iso" [100] "bool savefp16" [false]
PixelFilter "box" "float xradius" [0.5] "float yradius" [0.5]
Sampler "independent" "integer pixelsamples" [4096] "integer seed" [0]
Integrator "path" "integer maxdepth" [6]
WorldBegin
LightSource "infinite" "float scale" [.5]
Texture "chart" "spectrum" "imagemap" "string filename" ["assets/focus-chart.png"] "string filter" ["ewa"]
Material "diffuse" "texture reflectance" "chart"
Shape "trianglemesh" "point3 P" [-1.1 -1 3 0.04999999999999982 -1 3 0.04999999999999982 1 3 -1.1 1 3]
 "point2 uv" [0 0 1 0 1 1 0 1] "integer indices" [0 2 1 0 3 2]
Shape "trianglemesh" "point3 P" [0.1 -2 7 2.1 -2 7 2.1 2 7 0.1 2 7]
 "point2 uv" [0 0 1 0 1 1 0 1] "integer indices" [0 2 1 0 3 2]
