# Owned two parallel glass slabs: four delta interfaces before visible emission.
Camera "perspective" "float fov" [28]
Film "rgb" "integer xresolution" [8] "integer yresolution" [8]
 "string sensor" "cie1931" "float iso" [100] "bool savefp16" [false]
PixelFilter "box"
Sampler "independent" "integer pixelsamples" [4096] "integer seed" [0]
Integrator "path" "integer maxdepth" [6]
WorldBegin
AttributeBegin
Material "diffuse" "rgb reflectance" [0 0 0]
AreaLightSource "diffuse" "float scale" [10] "bool twosided" [true]
Shape "trianglemesh" "point3 P" [-20 -20 5 20 -20 5 20 20 5 -20 20 5]
 "integer indices" [0 1 2 0 2 3]
AttributeEnd
Material "dielectric" "float eta" [1.5] "float roughness" [0]
Shape "trianglemesh" "point3 P" [-10 -10 2 10 -10 2 10 10 2 -10 10 2]
 "integer indices" [0 2 1 0 3 2]
Shape "trianglemesh" "point3 P" [-10 -10 2.2 10 -10 2.2 10 10 2.2 -10 10 2.2]
 "integer indices" [0 1 2 0 2 3]
Shape "trianglemesh" "point3 P" [-10 -10 3 10 -10 3 10 10 3 -10 10 3]
 "integer indices" [0 2 1 0 3 2]
Shape "trianglemesh" "point3 P" [-10 -10 3.2 10 -10 3.2 10 10 3.2 -10 10 3.2]
 "integer indices" [0 1 2 0 2 3]
