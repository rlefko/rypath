# SPDX-License-Identifier: GPL-3.0-only
Camera "perspective" "float fov" [35]
Film "rgb" "integer xresolution" [8] "integer yresolution" [8]
    "string sensor" "cie1931" "float iso" [100] "bool savefp16" [false]
PixelFilter "box" "float xradius" [0.5] "float yradius" [0.5]
Sampler "independent" "integer pixelsamples" [4096] "integer seed" [0]
Integrator "path" "integer maxdepth" [0]
WorldBegin

# Opposed normals turn the left one-sided panel toward the camera. The right
# panel combines mirroring with explicit reversal.
Material "diffuse" "rgb reflectance" [0 0 0]
AttributeBegin
    AreaLightSource "diffuse" "rgb L" [2 0.1 0.6]
    Shape "trianglemesh" "point3 P" [-0.7 -0.7 2 -0.03 -0.7 2 -0.03 0.7 2 -0.7 0.7 2]
        "integer indices" [0 1 2 0 2 3]
        "normal N" [0 0 -1 1 0 -2 1 1 -3 0 1 -4]
AttributeEnd
AttributeBegin
    Scale -1 1 1
    ReverseOrientation
    AreaLightSource "diffuse" "rgb L" [0.1 2 0.6]
    Shape "trianglemesh" "point3 P" [-0.7 -0.7 2 -0.03 -0.7 2 -0.03 0.7 2 -0.7 0.7 2]
        "integer indices" [0 1 2 0 2 3]
        "normal N" [0 0 1 1 0 2 1 1 3 0 1 4]
AttributeEnd
