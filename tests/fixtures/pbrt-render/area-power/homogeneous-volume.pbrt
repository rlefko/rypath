MakeNamedMedium "fog" "string type" "homogeneous" "spectrum sigma_a" [360 .1 830 .1] "spectrum sigma_s" [360 .15 830 .15] "float g" [.2]
MediumInterface "" "fog"
Camera "perspective" "float fov" [7.152668749994703]
Film "rgb" "integer xresolution" [8] "integer yresolution" [8]
    "string sensor" "cie1931" "float iso" [100] "bool savefp16" [false]
PixelFilter "box" "float xradius" [0.5] "float yradius" [0.5]
Sampler "independent" "integer pixelsamples" [4096] "integer seed" [0]
Integrator "volpath" "integer maxdepth" [3]
WorldBegin

Material "diffuse" "spectrum reflectance" [360 .6 830 .6]
Shape "trianglemesh" "point3 P" [-.125 -.125 2 -.125 .125 2 .125 .125 2 .125 -.125 2] "integer indices" [0 1 2 0 2 3]
AttributeBegin
Material "diffuse" "rgb reflectance" [0 0 0]
AreaLightSource "diffuse" "spectrum L" "assets/emission.spd" "float power" [80] "bool twosided" [true]
Shape "trianglemesh" "point3 P" [.25 -.5 1 1.5 -.5 1 .25 .5 1] "integer indices" [0 1 2]
AttributeEnd
