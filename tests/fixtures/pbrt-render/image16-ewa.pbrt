# SPDX-License-Identifier: GPL-3.0-only
Camera "perspective" "float fov" [53.1301023542]
Film "rgb" "integer xresolution" [8] "integer yresolution" [8]
    "string sensor" "cie1931" "float iso" [100] "bool savefp16" [false]
PixelFilter "triangle" "float xradius" [0.00390625] "float yradius" [0.00390625]
Sampler "independent" "integer pixelsamples" [4096] "integer seed" [0]
Integrator "path" "integer maxdepth" [1]
WorldBegin
LightSource "infinite"
# Owned wrapper around the pinned PNGSuite grayscale16 image. The rotated
# footprint crosses the repeat seam near (0.025, 0.6) and blends mips 0 and 1.
Texture "surface" "spectrum" "imagemap" "string filename" "image-assets/basn0g16.png"
    "string wrap" "repeat" "string encoding" "linear" "string filter" "ewa"
    "float maxanisotropy" [8]
Material "diffuse" "texture reflectance" "surface"
Shape "trianglemesh" "point3 P" [-1 -1 2 1 -1 2 -1 1 2 1 1 2]
    "integer indices" [0 1 2 2 1 3]
    "point2 uv" [-2.027 -13.208 2.773 10.472 -3.179 -12.696 1.621 10.984]
