# SPDX-License-Identifier: GPL-3.0-only
Camera "perspective" "float fov" [53.1301023542]
Film "rgb" "integer xresolution" [8] "integer yresolution" [8]
    "string sensor" "cie1931" "float iso" [100] "bool savefp16" [false]
PixelFilter "triangle" "float xradius" [0.00390625] "float yradius" [0.00390625]
Sampler "independent" "integer pixelsamples" [4096] "integer seed" [0]
Integrator "path" "integer maxdepth" [1]
WorldBegin
LightSource "infinite"
# Both cards resolve all eight source texels. Each channel has a constant high
# byte, so replacing the low bytes with zeros makes each card flat.
Texture "default-srgb" "spectrum" "imagemap" "string filename" "image-assets/asymmetric16.png"
    "string wrap" "clamp" "string filter" "point" "float scale" [128]
Texture "linear" "spectrum" "imagemap" "string filename" "image-assets/asymmetric16.png"
    "string wrap" "clamp" "string filter" "point" "string encoding" "linear" "float scale" [16]
Material "diffuse" "texture reflectance" "default-srgb"
Shape "trianglemesh" "point3 P" [-1 -1 2 0 -1 2 -1 1 2 0 1 2]
    "integer indices" [0 1 2 2 1 3] "point2 uv" [0 0 1 0 0 1 1 1]
Material "diffuse" "texture reflectance" "linear"
Shape "trianglemesh" "point3 P" [0 -1 2 1 -1 2 0 1 2 1 1 2]
    "integer indices" [0 1 2 2 1 3] "point2 uv" [0 0 1 0 0 1 1 1]
