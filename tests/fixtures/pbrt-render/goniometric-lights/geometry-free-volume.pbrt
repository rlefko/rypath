MakeNamedMedium "fog" "string type" "homogeneous" "spectrum sigma_a" [360 .3 830 .3] "spectrum sigma_s" [360 .7 830 .7] "float g" [-.55]
MediumInterface "" "fog"
# SPDX-License-Identifier: GPL-3.0-only
# Original rypath goniometric acceptance wrapper; asset terms recorded separately.
Camera "perspective" "float fov" [28]
Film "rgb" "integer xresolution" [8] "integer yresolution" [8]
 "string sensor" "cie1931" "float iso" [100] "bool savefp16" [false]
PixelFilter "box"
Sampler "independent" "integer pixelsamples" [4096] "integer seed" [0]
Integrator "volpath" "integer maxdepth" [3]
WorldBegin
AttributeBegin
Translate 1 .7 1
LightSource "goniometric" "string filename" ["assets/asymmetric.png"] "spectrum I" [360 4 830 4]
AttributeEnd
