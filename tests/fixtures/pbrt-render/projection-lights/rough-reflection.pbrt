# SPDX-License-Identifier: GPL-3.0-only
# Original rypath projection acceptance wrapper; asset terms recorded separately.
Camera "perspective" "float fov" [28]
Film "rgb" "integer xresolution" [8] "integer yresolution" [8]
 "string sensor" "cie1931" "float iso" [100] "bool savefp16" [false]
PixelFilter "box"
Sampler "independent" "integer pixelsamples" [4096] "integer seed" [0]
Integrator "path" "integer maxdepth" [1]
WorldBegin
AttributeBegin
Translate 1 .7 1
LightSource "projection" "string filename" ["assets/landscape.png"] "float scale" [1000]
AttributeEnd
Material "conductor" "spectrum eta" [360 1.2 830 1.2] "spectrum k" [360 2 830 2] "float roughness" [.3] "bool remaproughness" [false]
Shape "trianglemesh" "point3 P" [-4 -4 3 4 -4 3 4 4 3 -4 4 3] "integer indices" [0 2 1 0 3 2]
