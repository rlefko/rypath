# SPDX-License-Identifier: GPL-3.0-only
Camera "perspective" "float fov" [7.152668749994703]
Film "rgb" "integer xresolution" [8] "integer yresolution" [8]
    "string sensor" "cie1931" "float iso" [100] "bool savefp16" [false]
PixelFilter "box" "float xradius" [0.5] "float yradius" [0.5]
Sampler "independent" "integer pixelsamples" [4096] "integer seed" [0]
Integrator "path" "integer maxdepth" [1]
WorldBegin

# The light is behind the receiver's geometric plane. Smooth normals open
# part of the shading hemisphere toward the emitter at positive x.
Material "diffuse" "rgb reflectance" [0.6 0.4 0.8]
Shape "trianglemesh" "point3 P" [-0.5 -0.5 2 -0.5 0.5 2 0.5 0.5 2 0.5 -0.5 2]
    "integer indices" [0 1 2 0 2 3]
    "normal N" [0.5 0 -1 1 1 -1 8 0 -1 5 -1 -1]
    "point2 uv" [0 0 0 1 1 1 1 0]
AttributeBegin
    Material "diffuse" "rgb reflectance" [0 0 0]
    AreaLightSource "diffuse" "spectrum L" [360 0.25 485 0.8 650 1 830 0.25]
    Shape "trianglemesh" "point3 P" [0.25 -0.75 2.5 0.25 0.75 2.5 1.25 0.75 2.5]
        "integer indices" [0 1 2]
AttributeEnd
