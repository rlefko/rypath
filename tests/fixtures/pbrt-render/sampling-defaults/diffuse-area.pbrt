# Original rypath sampling/defaults fixture; see README.md.
Camera "perspective" "float fov" [53.1301023542]
Film "rgb" "integer xresolution" [8] "integer yresolution" [8]
 "string sensor" "cie1931" "float iso" [100] "bool savefp16" [false]
PixelFilter "gaussian" "float xradius" [2.5] "float yradius" [0.8] "float sigma" [0.7]
Sampler "halton" "string randomization" ["permutedigits"] "integer pixelsamples" [4096] "integer seed" [0]
Integrator "path" "integer maxdepth" [5]
WorldBegin
LightSource "infinite" "rgb L" [.08 .12 .2]
Material "diffuse" "rgb reflectance" [.55 .35 .12]
Shape "trianglemesh" "point3 P" [-3 -3 5 3 -3 5 3 3 5 -3 3 5] "integer indices" [0 2 1 0 3 2]
AttributeBegin
Material "diffuse" "rgb reflectance" [.1 .15 .2]
Shape "trianglemesh" "point3 P" [-.3 -2 3 .7 -2 3 .7 .4 3 -.3 .4 3] "integer indices" [0 2 1 0 3 2]
AttributeEnd
AttributeBegin
AreaLightSource "diffuse" "rgb L" [5 4 2] "bool twosided" [true]
Material "diffuse" "rgb reflectance" [0 0 0]
Shape "trianglemesh" "point3 P" [-2 1 2 1 1 2 1 3 3 -2 3 3] "integer indices" [0 2 1 0 3 2]
AttributeEnd
