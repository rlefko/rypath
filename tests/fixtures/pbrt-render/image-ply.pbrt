Camera "perspective" "float fov" [34]
Film "rgb" "integer xresolution" [8] "integer yresolution" [8]
    "string sensor" "cie1931" "float iso" [100] "bool savefp16" [false]
PixelFilter "box" "float xradius" [0.5] "float yradius" [0.5]
Sampler "independent" "integer pixelsamples" [4096] "integer seed" [0]
Integrator "path" "integer maxdepth" [1]
WorldBegin
LightSource "infinite" "rgb L" [1 1 1]
# Owned wrapper around the unmodified PNGSuite asset; see image-assets/README.md.
Texture "surface" "spectrum" "imagemap" "string filename" "image-assets/z03n2c08.png"
    "float uscale" [0.62] "float vscale" [0.73] "float udelta" [0.24] "float vdelta" [0.10]
    "string wrap" "black"
Material "diffuse" "texture reflectance" "surface"
Shape "plymesh" "string filename" ["ply-assets/mixed.ply"]
